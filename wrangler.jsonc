{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allah",
  "main": "worker.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "PrayerRoom"
      },
      {
        "name": "COMMUNITY",
        "class_name": "Community"
      },
      {
        "name": "REMINDERS",
        "class_name": "PrayerReminders"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PrayerRoom",
        "Community"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PrayerReminders"
      ]
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "vars": {
    "NOOR_ROOM_CAPACITY": "50"
  },
  "routes": [
    {
      "pattern": "noorrealm.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
